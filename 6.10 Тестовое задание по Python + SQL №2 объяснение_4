# ================== ШКОЛЬНЫЙ РАЗБОР ОБМЕННИКА ВАЛЮТ ==================
# Представь, что мы строим банк в школе. У нас есть:
# - Бухгалтер (Database)
# - Разведчик (ExchangeRateFetcher)
# - Кассир (CurrencyExchanger)
# Все они работают вместе, чтобы менять валюту по настоящему курсу из интернета.

import sqlite3          # Библиотека для работы с базой данных SQLite (наша картотека)
import time             # Будем делать паузы, как человек
import random           # Чтобы паузы были случайными (не как робот)
import logging          # Ведём журнал событий (логи) вместо print
from datetime import date  # Узнаём сегодняшнюю дату (для кэша курсов)
from selenium import webdriver                    # Робот, управляющий браузером
from selenium.webdriver.common.by import By        # Способ поиска элементов (по XPath)
from selenium.webdriver.support.ui import WebDriverWait  # Ожидание появления элементов
from selenium.webdriver.support import expected_conditions as EC  # Условия (кликабельный и т.п.)
from selenium.webdriver.firefox.options import Options as FirefoxOptions  # Настройки Firefox
from selenium.webdriver.firefox.service import Service as FirefoxService  # Сервис Firefox
from selenium.common.exceptions import (           # Ошибки Selenium
    ElementClickInterceptedException,
    NoSuchElementException,
    TimeoutException
)

# ----------------------------- НАСТРОЙКА ЖУРНАЛА (ЛОГГЕР) -----------------------------
logging.basicConfig(
    level=logging.INFO,  # Пишем сообщения уровня INFO и выше (WARNING, ERROR)
    format='%(asctime)s [%(levelname)s] %(message)s',  # Формат: время, уровень, текст
    handlers=[logging.StreamHandler()]  # Выводим в консоль
)
logger = logging.getLogger(__name__)  # Создаём журнал с именем текущего модуля

# ----------------------------- КОНФИГУРАЦИЯ ---------------------------------
DB_NAME = 'exchanger.db'                  # Имя файла нашей базы данных
GECKODRIVER_PATH = r"C:\WebDriver\geckodriver.exe"  # Путь к драйверу Firefox (локально)

# =============================================================================
# 1. БУХГАЛТЕР (РАБОТАЕТ С БАЗОЙ ДАННЫХ)
# =============================================================================
class Database:
    def __init__(self, db_name=DB_NAME):
        self.db_name = db_name  # Запоминаем имя файла базы данных
        # Открываем соединение с базой. with сам закроет его после выхода.
        with sqlite3.connect(self.db_name) as conn:
            cur = conn.cursor()  # "Рука" для выполнения SQL-команд
            # Создаём таблицу, если её ещё нет (IF NOT EXISTS)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS users_balance (
                    UserID INTEGER PRIMARY KEY AUTOINCREMENT,  -- Уникальный ID, сам растёт
                    Balance_RUB REAL NOT NULL,  -- Рубли, число с плавающей точкой, обязательно
                    Balance_USD REAL NOT NULL,  -- Доллары
                    Balance_EUR REAL NOT NULL   -- Евро
                );
            """)
            # Проверяем, есть ли уже записи в таблице
            cur.execute("SELECT COUNT(*) FROM users_balance")
            if cur.fetchone()[0] == 0:  # Если ноль записей – таблица пуста
                # Вставляем начального пользователя с большими деньгами
                # Знаки ? – это параметры, защита от SQL-инъекций!
                cur.execute(
                    "INSERT INTO users_balance (Balance_RUB, Balance_USD, Balance_EUR) VALUES (?, ?, ?)",
                    (100000.0, 1000.0, 1000.0)
                )
        logger.info("База данных готова.")  # Делаем запись в журнале

    def get_balances(self, user_id=1):
        # Получаем баланс конкретного пользователя (по умолчанию ID=1)
        with sqlite3.connect(self.db_name) as conn:
            cur = conn.cursor()
            cur.execute("SELECT Balance_RUB, Balance_USD, Balance_EUR FROM users_balance WHERE UserID = ?", (user_id,))
            row = cur.fetchone()  # Забираем одну строку
            if row:
                # Возвращаем в виде словаря для удобства
                return {'RUB': row[0], 'USD': row[1], 'EUR': row[2]}
            return None

    def update_balance(self, user_id, currency, amount):
        # Изменяем баланс по одной валюте (amount может быть отрицательным – снятие)
        with sqlite3.connect(self.db_name) as conn:
            cur = conn.cursor()
            # Динамически подставляем имя колонки (Balance_RUB/Balance_USD/Balance_EUR)
            cur.execute(f"UPDATE users_balance SET Balance_{currency} = Balance_{currency} + ? WHERE UserID = ?", (amount, user_id))
            # commit не нужен – with сам зафиксирует изменения

