## 1. Полный код решения

```python
import sqlite3
import random
import csv
import os
from datetime import datetime, timedelta

class MobileCalls:
    def __init__(self, db_name="mobile_calls.db"):
        """Инициализация: подключение к базе данных и создание курсора."""
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()
        self.create_tables()
        self.fill_initial_data()
        # Список операторов и их цены будем загружать один раз
        self.operators = self.load_operators()
        self.start_date = datetime.now().date()

    def create_tables(self):
        """Создание таблиц mobile_users и mobile_price, если их нет."""
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS mobile_users (
                UserID INTEGER PRIMARY KEY,
                User TEXT,
                Balance INTEGER
            )
        """)
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS mobile_price (
                PriceID INTEGER PRIMARY KEY,
                Mts_Mts INTEGER,
                Mts_Tele2 INTEGER,
                Mts_Yota INTEGER
            )
        """)
        self.conn.commit()
        print("Таблицы созданы или уже существуют.")

    def fill_initial_data(self):
        """Заполнение таблиц начальными данными, если они пустые."""
        # Проверяем mobile_users
        self.cursor.execute("SELECT COUNT(*) FROM mobile_users")
        if self.cursor.fetchone()[0] == 0:
            self.cursor.execute(
                "INSERT INTO mobile_users (UserID, User, Balance) VALUES (?, ?, ?)",
                (1, "User1", 500)
            )
            print("Добавлен пользователь User1 с балансом 500.")
        else:
            print("Данные пользователей уже существуют.")

        # Проверяем mobile_price
        self.cursor.execute("SELECT COUNT(*) FROM mobile_price")
        if self.cursor.fetchone()[0] == 0:
            self.cursor.execute(
                "INSERT INTO mobile_price (PriceID, Mts_Mts, Mts_Tele2, Mts_Yota) VALUES (?, ?, ?, ?)",
                (1, 1, 2, 3)
            )
            print("Добавлены тарифы: Mts_Mts=1, Mts_Tele2=2, Mts_Yota=3.")
        else:
            print("Данные тарифов уже существуют.")
        self.conn.commit()

    def load_operators(self):
        """Загружает список операторов и их цен из таблицы mobile_price."""
        self.cursor.execute("SELECT Mts_Mts, Mts_Tele2, Mts_Yota FROM mobile_price WHERE PriceID = 1")
        row = self.cursor.fetchone()
        if row:
            operators = [
                ("Mts_Mts", row[0]),
                ("Mts_Tele2", row[1]),
                ("Mts_Yota", row[2])
            ]
            return operators
        else:
            print("Ошибка: таблица тарифов пуста!")
            return []

    def report_operation(self, date_str, operator, minutes, amount):
        """
        Записывает успешную операцию в файл report_mobile.csv.
        Поля: Date, Operator, Count_min, Amount.
        Если файл не существует, добавляет заголовки.
        """
        file_exists = os.path.exists("report_mobile.csv")
        try:
            with open("report_mobile.csv", "a", newline='', encoding='utf-8') as file:
                writer = csv.writer(file, delimiter=";")
                if not file_exists:
                    writer.writerow(["Date", "Operator", "Count_min", "Amount"])
                writer.writerow([date_str, operator, minutes, amount])
            print(f"Запись в отчёт: {date_str}, {operator}, {minutes} мин, {amount} руб.")
            return True
        except Exception as e:
            print(f"Ошибка записи в report_mobile.csv: {e}")
            return False

    def make_call(self, day_number):
        """
        Выполняет один звонок за день:
        - случайный выбор оператора и минут
        - проверка достаточности баланса
        - списание средств и запись в отчёт при успехе
        Возвращает True/False.
        """
        # Текущая дата для этого дня
        current_date = self.start_date + timedelta(days=day_number - 1)
        date_str = current_date.strftime("%d.%m.%Y")

        # Случайный выбор оператора и минут
        if not self.operators:
            print("Нет доступных операторов!")
            return False
        operator, price_per_min = random.choice(self.operators)
        minutes = random.randint(1, 10)
        amount = price_per_min * minutes

        # Получаем текущий баланс пользователя
        self.cursor.execute("SELECT Balance FROM mobile_users WHERE UserID = 1")
        result = self.cursor.fetchone()
        if not result:
            print("Пользователь не найден!")
            return False
        balance = result[0]

        print(f"День {day_number} ({date_str}):")
        print(f"  Выбран оператор: {operator}, минут: {minutes}, цена минуты: {price_per_min}, сумма: {amount}")

        # Проверка достаточности средств
        if balance < amount:
            print(f"  Недостаточно средств! Требуется: {amount}, доступно: {balance}. Звонок не совершён.")
            return False

        # Списание средств
        new_balance = balance - amount
        self.cursor.execute("UPDATE mobile_users SET Balance = ? WHERE UserID = 1", (new_balance,))
        self.conn.commit()
        print(f"  Звонок успешен. Новый баланс: {new_balance}")

        # Запись в отчёт
        self.report_operation(date_str, operator, minutes, amount)
        return True

    def run_month(self):
        """Запускает 30 итераций (дней) с ежедневным звонком."""
        print("Начало месяца (30 дней):")
        for day in range(1, 31):
            self.make_call(day)
            print("-" * 40)

    def close(self):
        """Закрывает соединение с базой данных."""
        self.conn.close()
        print("Соединение с базой данных закрыто.")

if __name__ == "__main__":
    app = MobileCalls()
    app.run_month()
    app.close()
```

